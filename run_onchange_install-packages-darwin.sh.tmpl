{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

{{ range .packages.darwin.crates -}}
cargo install {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.nodes -}}
npm install -g {{ . | quote }}
{{ end -}}

# Homebrew >= 6 refuses to load formulae/casks from third-party taps unless trusted
{{ range .packages.darwin.taps -}}
brew tap {{ . | quote }} && brew trust --tap {{ . | quote }}
{{ end }}
# --no-upgrade: installing is chezmoi's job, upgrading is topgrade's
brew bundle --no-upgrade --file=/dev/stdin <<EOF
{{ range .packages.darwin.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
{{- if not .isWorkLaptop -}}
{{ range .packages.darwin.caskspersonal -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
{{- if .isWorkLaptop -}}
{{ range .packages.darwin.caskswork -}}
cask {{ . | quote }}
{{ end -}}
{{ end -}}
EOF

# VS Code extensions are installed here rather than as brew bundle `vscode` lines.
# `code --install-extension` returns before VS Code has finished rewriting
# ~/.vscode/extensions/extensions.json, so the back-to-back invocations brew bundle
# makes race each other and fail with ENOTEMPTY / EntryNotFound / "Cannot read the
# extension". One invocation is atomic, resolves shared dependencies (remote-ssh pulls
# in remote-ssh-edit) exactly once, and skips whatever is already installed.
vscode_args=()
{{ range .packages.darwin.vscode -}}
vscode_args+=(--install-extension {{ . | quote }})
{{ end -}}
code "${vscode_args[@]}"
{{ end -}}
