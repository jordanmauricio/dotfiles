export PATH=$HOME/bin:/usr/local/bin:$PATH
export EDITOR="code --wait"

# Resolve chezmoi cd
CHEZMOI_HOME="$HOME/projects/dotfiles"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

[ ! -d $ZINIT_HOME ] && mkdir -p "$(dirname $ZINIT_HOME)"
[ ! -d $ZINIT_HOME/.git ] && git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"

source "${ZINIT_HOME}/zinit.zsh"

zinit ice depth=1; zinit light romkatv/powerlevel10k

# evalcache: cache the output of `eval "$(tool init)"` calls so each shell start
# doesn't spawn the tool. Invalidate with `_evalcache_clear` after upgrading a tool.
zinit light mroth/evalcache

_evalcache /opt/homebrew/bin/brew shellenv
_evalcache zoxide init zsh
_evalcache fzf --zsh
# fnm is deliberately NOT cached: its output contains a per-shell multishell path
eval "$(fnm env --use-on-cd --version-file-strategy=recursive)"
# brew's command-not-found handler (built into brew; ~700ms uncached, so cache it)
_evalcache brew command-not-found-init

# gcloud only supports up to a specific Python minor; pin it without holding back the default python3
export CLOUDSDK_PYTHON="$HOMEBREW_PREFIX/opt/python@3.13/bin/python3.13"

# Plugins, loaded in turbo mode (after the first prompt) so they don't delay startup.
# Order matters: completions must be in fpath before compinit; fzf-tab needs compinit
# first; syntax-highlighting and autosuggestions last.
# compinit runs with -C (skip compaudit, reuse the dump). After installing a tool with
# new completions run `compinit` once (or `rm ~/.zcompdump*`).
zinit wait lucid light-mode for \
  blockf atpull'zinit creinstall -q .' zsh-users/zsh-completions \
  atinit'ZINIT[COMPINIT_OPTS]=-C; zicompinit; zicdreplay' Aloxaf/fzf-tab \
  OMZP::git \
  OMZP::1password \
  zsh-users/zsh-syntax-highlighting \
  atload'_zsh_autosuggest_start' zsh-users/zsh-autosuggestions

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Source the dotfiles (order matters)
for DOTFILE in "$CHEZMOI_HOME"/configs/{functions,aliases}; do
  [ -f "$DOTFILE" ] && . "$DOTFILE"
done

# Keybindings
bindkey "^p" history-beginning-search-backward
bindkey "^n" history-beginning-search-forward

# History
HISTSIZE=10000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_find_no_dups

LS_COLORS='di=1;34:fi=0:ln=31:pi=5:so=5:bd=5:cd=5:or=31'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --color=always $realpath'

# GH_TOKEN lives in 1Password. Fetch it lazily on first `gh` use instead of on every
# shell start (the `op` round-trip was the main startup delay). Inherited values are kept.
# Run `gh_token` yourself if another tool needs GH_TOKEN exported in the current shell.
gh_token() {
  export GH_TOKEN="$(op item get tzcbernwu4gktzonwchcbgv5km --reveal --fields label=token)"
}
gh() {
  [ -n "$GH_TOKEN" ] || gh_token
  command gh "$@"
}

export PATH=/opt/homebrew/opt/sqlite/bin:$PATH

export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH=$PATH:$ANDROID_HOME/emulator
export PATH=$PATH:$ANDROID_HOME/platform-tools

# go (Homebrew's go knows its own GOROOT; only GOPATH/bin is needed on PATH)
export GOPATH=$HOME/go
export PATH="$PATH:${GOPATH}/bin"

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end
export PATH="$HOME/.local/bin:$PATH"

# opencode
export PATH=$HOME/.opencode/bin:$PATH

# Machine-local, untracked overrides (work env vars etc.) — never committed
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
