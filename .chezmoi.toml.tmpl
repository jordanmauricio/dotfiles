{{- $name := promptStringOnce . "name" "What's your name?" -}}

{{- $email := promptStringOnce . "email" "And email address?" -}}

{{- $workEmail := promptStringOnce . "workEmail" "And your work email address?" -}}

{{- $givenName := promptStringOnce . "computerName" "What do you want to name this machine?" -}}

{{- $isWorkLaptop := promptStringOnce . "isWorkLaptop" "Is this a work laptop? y/n" -}}

{{- $gpgGit := promptStringOnce . "gpgGit" "Paste the SSH public key used for git commit signing (1Password SSH agent)" -}}

sourceDir = "{{ .chezmoi.homeDir }}/projects/dotfiles"

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    workEmail = {{ $workEmail | quote }}
    computerName = {{ $givenName | quote }}
    isWorkLaptop = {{ $isWorkLaptop | quote }}
    gpgGit = {{ $gpgGit | quote }}

[edit]
    command = "code"
    args = ["--wait"]

[diff]
    pager = "hunk pager"

[merge]
    command = "code"
    args = ["--wait", "--merge"]
